{% extends "base.html.twig" %}

{% block title %}Home{% endblock %}

{% block content %}
	<form method="GET" action="{{ url_for('lookup') }}" class="home-form">
		<input type="text" name="user" placeholder="a creature's username..." />
		<button>OGLE THEIR CATS</button>
	</form>

	<h2>Leaderboard</h2>
	<ol>
		{% for item in leaderboard %}
			<li>
				<a href="{{ url_for('lookup') }}?user={{ item.user }}">{{ item.user }}</a>
				({{ item.totalCats }} cats)
			</li>
		{% endfor %}
	</ol>
{% endblock %}
