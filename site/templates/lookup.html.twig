{% extends "base.html.twig" %}

{% block title %}{{ username }}{% endblock %}

{% block content %}
	<h2>{{ username }}</h2>

	<ul class="user-stats" aria-label="Statistics">
		<li>
			<strong>{{ cats|length }}</strong> cats
		</li>
		{% if leaderboard_pos != null %}
			<li>
				<strong>#{{ leaderboard_pos }}</strong> on leaderboards
			</li>
		{% endif %}
	</ul>

	<div class="notice notice--info">
		<header>Cat images will (hopefully) be revamped</header>
		I'm still working on custom cat avatars!! For now, the current cat images are just
		placeholders generated by <a href="https://robohash.org">robohash.org</a>!
	</div>
	
	<ul class="cat-grid" aria-label="Cats">
		{% for cat in cats %}
			<li>
				<img src="https://robohash.org/{{ cat }}?set=set4" alt="{{ cat }}" /><br>
				{{ cat }}
			</li>
		{% endfor %}
	</ul>
{% endblock %}
